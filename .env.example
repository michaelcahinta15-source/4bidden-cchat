# Copy this file to .env and replace the placeholder with a long random secret.
APP_ACCESS_KEY=TANGINAMO
# Optional chat-only key; this key cannot open the analytics dashboard.
# APP_ACCESS_KEY_2=replace-with-a-different-long-random-secret

# If running behind a trusted HTTPS reverse proxy, set this to true.
# TRUST_PROXY=true

# Increase only when your hosting platform also allows larger request bodies.
# CHAT_BODY_LIMIT=64mb
